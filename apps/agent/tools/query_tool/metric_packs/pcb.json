{
  "version": 1,
  "pack_id": "pcb",
  "note": "可选行业包。仅当资料包声明 metric_packs 含 pcb 时加载。禁止写死实体 id；用 entity_hints + 字段角色；看板类可用 allow_unfiltered。报废率必须分子+分母或现成 rate 字段，否则只报件数。",
  "metrics": [
    {
      "id": "wip-by-process",
      "label": "工序在制",
      "aliases": ["工序在制", "各工序在制", "过站在制", "WIP by process"],
      "entity_hints": [
        "工序在制",
        "过站",
        "SFC",
        "工艺路线",
        "wip-by-process",
        "station-wip",
        "process-wip"
      ],
      "definition": "按工序/站点维度的在制清单。无工序维 WIP 接口时绑不上（产线 WIP 快照、工单在制均不算工序在制）。",
      "include_in_brief": false,
      "category_field_hints": ["process", "station", "operation", "step", "工序", "站点"],
      "value_field_hints": ["qty", "quantity", "wip_qty", "count", "amount"],
      "clauses": [
        {
          "field_role": "status",
          "field_hints": ["status", "state", "wipStatus", "processStatus", "状态"],
          "include_values": ["in_progress", "processing", "wip", "running", "进行中", "在制", "生产中"]
        }
      ]
    },
    {
      "id": "daily-output",
      "label": "当日/日产出",
      "aliases": [
        "当日产出",
        "日产出",
        "今天产出",
        "今日产出",
        "产量趋势",
        "日产出趋势",
        "当日过站",
        "daily output"
      ],
      "entity_hints": [
        "生产概览（联动版）",
        "production-overview-v2",
