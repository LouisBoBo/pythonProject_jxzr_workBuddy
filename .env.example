# ============================================================
# LLM 配置
# ============================================================
# DeepSeek（推荐）
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 硅基流动（备选，国内直连）
# SILICONFLOW_API_KEY=your-siliconflow-key
# MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# ============================================================
# ERP 平台连接
# ============================================================
# 平台地址（不含 /api 后缀）
PLATFORM_BASE_URL=http://localhost:8000

# ERP 登录凭据（仅服务端后台任务可选；用户走 Web 登录页）
# ERP_USERNAME=admin
# ERP_PASSWORD=admin123
# ERP_ENTERPRISE_CODE=

# 是否强制登录后才能调用对话/历史（默认 true；纯 Mock 可设 false）
# AUTH_REQUIRED=true

# 平台嵌入：允许的前端源（逗号分隔；默认 * 便于本地。上线改为 MES 域名）
# CORS_ALLOW_ORIGINS=*
# 例：CORS_ALLOW_ORIGINS=https://mes.example.com,http://127.0.0.1:5180

# ============================================================
# 高可用（多 API 实例共享卷）
# ============================================================
# 所有实例必须指向同一目录（NFS/共享盘/同一宿主机 ./data）
# DATA_DIR=/app/data
# 实例标识（写入审计与调用日志；默认识别 HOSTNAME）
# INSTANCE_ID=api-1
# 编排：docker compose -f docker-compose.ha.yml up -d --scale api=2
# 说明见 docs/高可用部署说明.md

# ============================================================
# Agent 配置
# ============================================================
# 单次导入最大行数
# MAX_IMPORT_ROWS=10000

# 导出文件是否保存到用户桌面（Windows / macOS / Linux 自动识别）
# 默认 true；设为 false 则保存到 ./exports
EXPORT_TO_DESKTOP=true

# 自定义导出目录（优先级高于 EXPORT_TO_DESKTOP）
# EXPORT_DIR=./data/exports

# ============================================================
# MES API / Web（monorepo）
# ============================================================
# MES_SERVER_PORT=8765
# VITE_PORT=5180
# 工具调用审计（默认 true）
# ENABLE_AUDIT_MIDDLEWARE=true

# 实体硬守卫：问计划却查工单时拦截（默认 false）
# ENABLE_ENTITY_GUARD=false

# 写操作须人工确认（默认 true；紧急回滚可设 false）
# REQUIRE_WRITE_CONFIRM=true
# 待确认写操作过期秒数（默认 1800 = 30 分钟）
# WRITE_CONFIRM_TTL_SEC=1800
# 审计查询默认回溯天数（未指定 since 时，默认只查近 30 天，避免全量）
# WRITE_AUDIT_DEFAULT_DAYS=30
# 审计文件最大保留行数（超限轮转）
# WRITE_AUDIT_MAX_LINES=50000

# ============================================================
# IDE 代码审核（M0/M1，默认全部关闭，不影响 MES 查/导/写）
# ============================================================
# 为 1 时 create_agent 才会挂载 request_ide_review；侧栏显示「代码载体」状态
# IDE_REVIEW_ENABLED=0
# Bridge 心跳超时秒数（超时视为离线，默认 45）
# IDE_BRIDGE_HEARTBEAT_TTL_SEC=45
# 等待本机 Bridge 回传超时秒数（默认 60）
# IDE_BRIDGE_TASK_TIMEOUT_SEC=120
# 配对兑换的 Bridge 长期凭证有效天数（默认 90）
# IDE_BRIDGE_TOKEN_TTL_DAYS=90
# 可选：自定义签名密钥；不设则写入 DATA_DIR/ide_bridge/.bridge_token_secret
# IDE_BRIDGE_TOKEN_SECRET=
# （M0 可选）冒烟或直连本机 MCP；M1 演示请用 Bridge，一般保持 0
# IDE_REVIEW_MCP=0
# IDE_REVIEW_MCP_REQUIRE=0
# IDE_REVIEW_MCP_COMMAND=npx
# IDE_REVIEW_MCP_ARGS=-y,vscode-as-mcp-server
# IDE_REVIEW_MCP_TOOL=code_checker
# IDE_REVIEW_MCP_TIMEOUT_SEC=45

# ============================================================
# API 接口健康分析（文档 × 出站日志）
# ============================================================
# 拉取 Swagger/OpenAPI 时允许的额外 host（逗号分隔；默认含 localhost/127.0.0.1/PLATFORM_BASE_URL host）
# API_DOCS_URL_ALLOWLIST=
# 出站调用日志最大保留行数（超限轮转）
# API_CALL_LOG_MAX_LINES=50000
# 探活沙箱：真实 HTTP 沙箱根地址（勿填生产）。dev.sh 默认启动本仓沙箱并设为 http://127.0.0.1:8001
# API_PROBE_SANDBOX_URL=http://127.0.0.1:8001
# API_PROBE_SANDBOX_PORT=8001
# API_PROBE_SANDBOX_HOST=127.0.0.1
# 沙箱 URL 额外允许的 host（逗号分隔）
# API_PROBE_SANDBOX_URL_ALLOWLIST=
