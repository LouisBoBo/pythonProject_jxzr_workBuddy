{
  "version": 1,
  "note": "通用指标口径模板。实体/字段/取值在运行时绑定当前资料包；换平台可在资料包放 metrics.json 按 id 覆盖。不要把某一套 MES 的实体 id 写进本文件。",
  "metrics": [
    {
      "id": "wip",
      "label": "在制",
      "aliases": ["在制", "在制工单", "进行中", "生产中"],
      "entity_hints": ["生产工单", "工单", "派工单", "制造工单", "生产任务", "作业单", "work order", "work-order", "mo"],
      "definition": "状态属于进行中/在制（已开工、尚未完工），不含待开工与已完工。",
      "clauses": [
        {
          "field_role": "status",
          "field_hints": ["status", "state", "billStatus", "orderStatus", "woStatus", "docStatus", "状态"],
          "include_values": ["in_progress", "processing", "producing", "wip", "running", "进行中", "在制", "生产中"]
        }
      ]
    },
    {
      "id": "pending",
      "label": "待处理",
      "aliases": ["待处理", "待开工", "未开始", "pending"],
      "entity_hints": ["生产工单", "工单", "派工单", "制造工单", "生产任务", "作业单", "work order", "work-order", "mo"],
      "definition": "状态属于待处理/待开工，尚未开始生产。",
      "clauses": [
        {
          "field_role": "status",
          "field_hints": ["status", "state", "billStatus", "orderStatus", "woStatus", "docStatus", "状态"],
          "include_values": ["pending", "draft", "released", "created", "open", "待处理", "待开工", "未开始"]
