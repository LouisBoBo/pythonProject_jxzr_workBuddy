      "entity_hints": ["生产工单", "工单", "派工单", "制造工单", "生产任务", "作业单", "work order", "work-order", "mo"],
      "definition": "优先级为紧急/高，且状态尚未完工/关闭。",
      "clauses": [
        {
          "field_role": "priority",
          "field_hints": ["priority", "pri", "urgency", "priorityLevel", "urgentLevel", "优先级"],
          "include_values": ["urgent", "high", "critical", "紧急", "高"]
        },
        {
          "field_role": "status",
          "field_hints": ["status", "state", "billStatus", "orderStatus", "woStatus", "docStatus", "状态"],
          "include_values": ["pending", "in_progress", "processing", "producing", "wip", "draft", "进行中", "待处理", "在制"],
          "exclude_values": ["completed", "closed", "done", "finished", "cancelled", "已完成", "已关闭", "完工"]
        }
      ]
    },
    {
