{
  "version": 2,
  "scope": "schema_only",
  "scope_note": "本能力地图只描述中软 MES 数据库表结构所反映的业务能力。查工单/排产、导入导出属于助手侧模拟演示，不代表、不改写平台真实能力。",
  "glossary": [
    {
      "term": "工单",
      "also_called": ["生产工单", "制造工单", "派工单", "WO", "MO"],
      "plain": "车间里真正要做的那一张活：做什么产品、做多少、做到哪了（表结构侧常见 TBL_MO 等）"
    },
    {
      "term": "生产计划",
      "also_called": ["排产计划", "排程计划", "排产", "排程", "PP"],
      "plain": "什么时候、在哪条线、打算做多少——偏计划层。中软 MES 表结构里不如工单/过站显眼；助手里的「查排产」是模拟演示，不是本地图的平台能力条目"
    },
    {
      "term": "IPQC",
      "also_called": ["首件检验", "制程检验"],
      "plain": "生产过程中的品质抽检/首件确认"
    },
    {
      "term": "OQC",
      "also_called": ["出货检验", "出货报告"],
      "plain": "货要出厂前的检验与出货报告"
    },
    {
      "term": "线边仓",
      "also_called": ["线别仓"],
      "plain": "产线旁边的小仓库，管产线领用的物料"
    },
    {
      "term": "工作中心",
      "also_called": ["设备", "机台", "WC"],
      "plain": "具体干活的设备或工位"
    }
  ],
