        {
          "field_role": "status",
          "field_hints": ["status", "state", "billStatus", "orderStatus", "woStatus", "docStatus", "状态"],
          "include_values": ["completed", "done", "finished", "complete", "已完成", "完工", "已完工"]
        }
      ]
    },
    {
      "id": "completed-today",
      "label": "当日完工",
