        "production-overview",
        "生产看板",
        "kanban-production",
        "设备产量排行",
        "device-output",
        "产出",
        "报工",
        "生产工单",
        "工单",
        "output",
        "production"
      ],
      "definition": "日产出相关：优先生产概览/看板/设备产量；否则工单完工清单。趋势图建议 analyze_time_trend（按 end_date/record_at 分桶，可对 actual_quantity 求和）。无日期筛参时不得说「今天产出了 N」。",
      "include_in_brief": false,
      "time_field_hints": [
        "end_date",
        "record_at",
        "output_date",
        "prod_date",
        "finished_at",
        "actual_end_time",
        "complete_date"
      ],
      "value_field_hints": [
        "actual_quantity",
        "actual_qty",
        "today_output",
        "week_output",
        "quantity",
        "output",
        "qty"
      ],
      "prefer_trend_tool": "analyze_time_trend",
      "clauses": [
        {
          "field_role": "status",
          "field_hints": ["status", "state", "billStatus", "orderStatus", "Status", "状态"],
          "include_values": ["completed", "done", "finished", "output", "closed", "已完成", "完工", "已产出", "已关闭"]
        },
        {
          "field_role": "date",
          "field_hints": [
            "end_date",
            "finished_at",
            "completed_at",
            "output_date",
            "prod_date",
            "report_date",
            "actual_end_time",
            "record_at"
          ],
          "relative": "today"
        }
      ]
    },
    {
