# ============================================================
# ZR WorkBuddy · 环境变量示例（P1-07 分层）
# 完整说明：docs/桌面与部署/配置旋钮分层与接手指南.md
# 解析顺序：settings.json（白名单）> 本文件/进程 env > 代码默认
# 分层：L0 启动必配 → L1 交付常用 → L2 功能开关 → L3 运维调优
# ============================================================

# ---------- L0 启动必配 ----------
# DeepSeek（推荐）；也可用界面写 LLM_API_KEY / LLM_BASE_URL
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# 禁止 deepseek-v4-pro（代码硬闸）；应急才设 LLM_ALLOW_BLOCKED_MODELS=1
# LLM_ALLOW_BLOCKED_MODELS=0

# 硅基流动（备选，国内直连）
# SILICONFLOW_API_KEY=your-siliconflow-key
# MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 平台地址（不含 /api 后缀）；桌面也可在「系统配置」覆盖
PLATFORM_BASE_URL=http://localhost:8000

# ---------- L1 交付常用 ----------
# ERP 登录凭据（仅服务端后台任务可选；用户走 Web 登录页）
# ERP_USERNAME=admin
# ERP_PASSWORD=admin123
# ERP_ENTERPRISE_CODE=

# 是否强制登录后才能调用对话/历史（默认 true；纯 Mock 可设 false）
# AUTH_REQUIRED=true

# 平台嵌入：允许的前端源（逗号分隔）
# 默认 * 便于本地；此时 API 会关闭 allow_credentials（规范禁止 * + credentials）。
# 上线 / 跨域 iframe：必须改为具体域名，并设 WORKBUDDY_ENV=production（生产禁止 *）。
# CORS_ALLOW_ORIGINS=*
# CORS_ALLOW_ORIGINS=https://mes.example.com,http://127.0.0.1:5180
# CORS_ALLOW_CREDENTIALS=true
# WORKBUDDY_ENV=development

# 导出：默认 true 写用户桌面；false 则 ./exports；EXPORT_DIR 优先
EXPORT_TO_DESKTOP=true
# EXPORT_DIR=./data/exports
# MAX_IMPORT_ROWS=10000

# MES API / Web（monorepo）端口
# MES_SERVER_PORT=8765
# VITE_PORT=5180
# ENABLE_AUDIT_MIDDLEWARE=true

# 写操作须人工确认（默认 true）
# REQUIRE_WRITE_CONFIRM=true
# WRITE_CONFIRM_TTL_SEC=1800
# WRITE_AUDIT_DEFAULT_DAYS=30
# WRITE_AUDIT_MAX_LINES=50000

# 实体硬守卫：问计划却查工单时拦截（默认 false）
# ENABLE_ENTITY_GUARD=false

# ---------- L2 功能开关（默认关 / 有独立上线清单）----------
# 截图理解：DeepSeek 等纯文本看不到图；默认智谱 GLM-4V-Flash
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# VISION_API_KEY=
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# VISION_MODEL=glm-4v-flash
# VISION_ENABLED=1
# VISION_MAX_IMAGES=3
# VISION_MAX_BYTES=8388608

# IDE 代码审核（默认关；手册 docs/写码与审码/IDE代码审核开发者接入手册.md）
# IDE_REVIEW_ENABLED=0
# IDE_BRIDGE_HEARTBEAT_TTL_SEC=45
# IDE_BRIDGE_TASK_TIMEOUT_SEC=120
# IDE_BRIDGE_TOKEN_TTL_DAYS=90
# IDE_BRIDGE_TOKEN_SECRET=
# IDE_REVIEW_MCP=0
# IDE_REVIEW_MCP_REQUIRE=0
# IDE_REVIEW_MCP_COMMAND=npx
# IDE_REVIEW_MCP_ARGS=-y,vscode-as-mcp-server
# IDE_REVIEW_MCP_TOOL=code_checker
# IDE_REVIEW_MCP_TIMEOUT_SEC=45

# Cursor 研发写码（同事零配；管理员清单 docs/写码与审码/Cursor写码车道管理员上线清单.md）
# 闸门：python3 scripts/check_cursor_dev_ready.py
# CURSOR_DEV_ENABLED=1
# CURSOR_API_KEY=
# CURSOR_DEV_REPO_ALLOWLIST=your-org/workbuddy-cursor-sandbox
# CURSOR_DEV_ALLOWED_USERS=
# CURSOR_DEV_MAX_CONCURRENT=3
# CURSOR_DEV_MAX_CONCURRENT_PER_USER=1
# CURSOR_DEV_JOB_TIMEOUT_SEC=2700
# CURSOR_DEV_MODEL=composer-2.5
# CURSOR_DEV_AUTO_PR=0
# CURSOR_DEV_SKIP_REVIEWER_REQUEST=1
# CURSOR_DEV_BRANCH_PREFIX=dev/wb/
# CURSOR_DEV_WORK_BRANCH=hebo
# CURSOR_DEV_STARTING_REF=hebo
# CURSOR_DEV_GITHUB_TOKEN=
# 或：GITHUB_TOKEN= / GH_TOKEN=

# 本机写码收尾：审码门禁 → 人确认 → 工作分支 commit / push（P1）
# 默认关：写码成功后不自动弹提交卡。人说「提交今天的代码」走人触发流程。
# LOCAL_DEV_COMMIT_GATE=0
# LOCAL_DEV_COMMIT_ALLOW_BLOCKED=0
# 人触发确认「提交并推送」时默认 push；显式设 0 可关掉默认推送（仍可在确认卡点推送）
# LOCAL_DEV_COMMIT_PUSH=0
# LOCAL_DEV_GIT_REMOTE=origin
# LOCAL_DEV_WORK_BRANCH=
# LOCAL_DEV_COMMIT_GATE_TIMEOUT_SEC=600
# 提交门禁是否走 ide_review 规则引擎（与 git/ide 审码工具同源；默认 1；0=仅本地少量正则）
# LOCAL_DEV_COMMIT_USE_IDE_REVIEW=1
# 提交批审：commit-batch-review Skill（LLM+JSON，非全量审码车道；默认 1）
# LOCAL_DEV_COMMIT_USE_SKILL_REVIEW=1

# 只读 SQL（默认关；须 DSN + 表白名单；也可在系统配置写）
# READONLY_SQL_ENABLED=0
# READONLY_SQL_DSN=
# READONLY_SQL_TABLE_WHITELIST=

# API 接口健康分析 / 探活沙箱（勿填生产）
# API_DOCS_URL_ALLOWLIST=
# API_CALL_LOG_MAX_LINES=50000
# API_PROBE_SANDBOX_URL=http://127.0.0.1:8001
# API_PROBE_SANDBOX_PORT=8001
# API_PROBE_SANDBOX_HOST=127.0.0.1
# API_PROBE_SANDBOX_URL_ALLOWLIST=

# ---------- L3 运维调优（平时别动）----------
# 高可用：多实例共享 DATA_DIR；见 docs/高可用部署说明.md
# DATA_DIR=/app/data
# INSTANCE_ID=api-1

# 对话 SSE 防代理攒包（默认 pad=512、sleep=0；顽固代理可恢复 2048 / 0.04）
# WORKBUDDY_SSE_PAD_BYTES=512
# WORKBUDDY_SSE_FLUSH_SLEEP_SEC=0
# WORKBUDDY_STREAM_LOCK_WAIT_SEC=0.15

# Agent 上下文 / 递归上限
# AGENT_RECURSION_LIMIT=500
# AGENT_CHECKPOINT_PATH=
# CONTEXT_MAX_MESSAGES=40
# CONTEXT_MAX_CHARS_PER_MSG=12000
# SYSTEM_PROMPT_COMPACT_CATALOG=true
