{
  "id": "pcb_ops",
  "label": "PCB / 品质运营看板",
  "description": "资料包通用模板：按 entity_hints / metric 绑定当前目录；缺卡诚实缺口。换平台只改资料包，不改本文件实体 id。对齐 M2：K1 报表工序在制、K3 设备产量优先。",
  "presentation": {
    "skin": "ops_dark",
    "lead_metric": "unfinished",
    "lead_label": "未完工",
    "kpi": [
      {
        "id": "wip_process",
        "label": "工序在制",
        "chart_id": "K1",
        "agg": "sum",
        "hint": "在制数量合计（报表维）"
      },
      {
        "id": "urgent",
        "label": "急单",
        "chart_id": "K2",
        "agg": "sum",
        "hint": "急单堆积合计"
      },
      {
        "id": "output",
        "label": "产出合计",
        "chart_id": "K3",
        "agg": "sum",
        "hint": "设备产量合计（今日为0时用本周）"
      },
      {
        "id": "defect_top",
        "label": "不良合计",
        "chart_id": "K4",
        "agg": "sum",
        "hint": "不良 Top 合计"
      }
    ]
  },
  "cards": [
    {
      "id": "K1",
      "title": "工序在制（报表）",
      "kind": "entity_series",
      "entity_hints": [
        "在制品报表",
        "reports-wip",
        "工序在制",
        "过站",
        "station-wip",
        "wip-by-process"
      ],
      "category_fields": [
        "current_process",
        "process",
        "station",
        "operation",
        "name",
        "label"
      ],
      "value_fields": [
        "wip_quantity",
        "actual_quantity",
        "plan_quantity",
        "qty",
        "quantity",
        "count"
      ],
      "chart_type": "bar",
      "chart_intent": "对比",
      "series_name": "在制数量",
      "limit": 80,
      "definition": "按当前工序汇总在制数量（报表/WIP 清单维）。非 SFC 过站全链路；无匹配实体则缺口。",
      "soft_gap": "无在制品报表或工序 WIP 接口时，请改问「在制工单」，勿声称过站工序在制。"
    },
    {
      "id": "K2",
      "title": "急单堆积",
      "kind": "metric_groups",
      "metric": "urgent-unfinished",
      "group_by_hints": ["优先级", "priority", "pri"],
      "chart_intent": "分布",
      "series_name": "条数"
    },
    {
      "id": "K3",
      "title": "日产出 / 设备产量",
      "kind": "entity_series",
      "entity_hints": [
        "设备产量排行",
        "device-output",
        "生产看板",
        "kanban-production",
        "生产概览（经典版）",
        "production-overview",
        "生产概览（联动版）",
        "production-overview-v2"
      ],
      "category_fields": [
        "name",
        "label",
        "code",
        "time",
        "device_name",
        "production_line",
        "line",
        "product_model",
        "key"
      ],
      "value_fields": [
        "today_output",
        "week_output",
        "lot_output",
        "model_output",
        "today_completed",
        "today_area_output",
        "quantity",
        "value",
        "output",
        "actual_qty",
        "actual_quantity",
        "count"
      ],
      "chart_intent": "对比",
      "series_name": "产量",
      "limit": 30,
      "definition": "优先设备产量排行（today_output；全 0 时自动改用 week_output）。按日趋势请对话用 analyze_time_trend。",
      "soft_gap": "若产量接口均无法抽成类目/数值，可改问「日产出」或「最近7天产量趋势」。"
    },
    {
      "id": "K4",
      "title": "检测/品质不良 Top",
      "kind": "entity_series",
      "entity_hints": [
        "Top 不良项",
        "不良分布",
        "quality-top-defects",
        "quality-defect-distribution",
        "top-defects"
      ],
      "category_fields": [
        "defect_type",
        "defect_code",
        "defect_name",
        "name",
        "label",
        "process",
        "code",
        "key"
      ],
      "value_fields": [
        "quantity",
        "value",
        "count",
        "qty",
        "fail_count",
        "defect_count",
        "ng_count"
      ],
      "chart_intent": "分布",
      "series_name": "数量",
      "limit": 20
    },
    {
      "id": "K5",
      "title": "工序良率 / 报废相关",
      "kind": "entity_series",
      "entity_hints": [
        "工序良率",
        "品质 KPI",
        "quality-process-yield",
        "quality-kpi",
        "process-yield"
      ],
      "category_fields": ["process", "label", "name", "key", "production_line"],
      "value_fields": [
        "yield_rate",
        "scrap_rate",
        "pass_rate",
        "value",
        "scrap_count",
        "defect_count",
        "total_inspected"
      ],
      "chart_type": "line",
      "chart_intent": "折线",
      "series_name": "良率",
      "limit": 30,
      "definition": "优先现成良率字段；无报废分子时勿口算报废率。"
    },
    {
      "id": "K_LOT",
      "title": "Lot / 拼板追溯",
      "kind": "gap",
      "gap_reason": "当前通用模板不假定 Lot/Panel/条码链路；资料包无对应实体时保持缺口。"
    }
  ]
}
